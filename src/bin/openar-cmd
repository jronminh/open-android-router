#!/system/bin/sh
# openar-cmd -- the command list from a shell (ADB): same file and same checks as the web page.
#   openar-cmd list                id, section, group, description, parameter regex
#   openar-cmd run <id> [param]    run it (over ADB every group runs; act runs are logged)
OPENAR_ROOT=${OPENAR_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
. "$OPENAR_ROOT/lib/openar-platform.sh"
. "$OPENAR_ROOT/lib/openar-commands.sh"
case "${1:-}" in
    list)
        echo "# $CMDS"
        cmd_list | awk -F'\t' '{ printf "%-10s %-16s %-5s %s  [%s]\n", $2, $1, $3, $7, $6 }' ;;
    run)
        [ -n "${2:-}" ] || { echo "usage: openar-cmd run <id> [param]" >&2; exit 64; }
        cmd_run "$2" any "${3:-}"; s=$?
        [ $s = 2 ] && { echo "openar-cmd: $r_err" >&2; exit 2; }
        print -r -- "$r_out"; [ -n "$r_err" ] && print -r -- "$r_err" >&2
        exit "$r_rc" ;;
    *) echo "usage: openar-cmd list | run <id> [param]" >&2; exit 64 ;;
esac
