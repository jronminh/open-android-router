#!/system/bin/sh
# title: Battery
# status block: charge level, status, temperature (0.1 C), USB power.
section_begin "Battery"; table_begin
kv "Level / status / temperature" "dumpsys battery | grep -E '^  (level|status|temperature):'"
kv "Power" "dumpsys battery | grep -m1 -E '^  (USB powered|AC powered):'"
kv "Charge limit" "settings get global protect_battery"
table_end; section_end
