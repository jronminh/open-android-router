# openar command list -- tab-separated columns:
#   id  section  group(auto|view|act)  confirm  timeout_s  param_regex  description  command
# group "auto" loads by itself on the page (status at a glance), "view" is read-only and runs on
# demand, "act" changes device state (web: POST + confirmation + log; ADB: openar-cmd run).
# A parameter is appended as one quoted word; "-" means the command takes none.
# The owner copy is etc/commands (same format) and wins over this default; edit both with vi.
#
# Floor rule: everything here must work on Android 6.0 with busybox, so no "cmd" (Android 7+),
# no private DNS (Android 9+). Device packs may add those for newer phones.
ifaces	Network	view	-	10	-	IPv4 addresses of all interfaces	ip -4 -o addr show
routes	Network	view	-	10	-	Main routing table	ip route
neigh	Network	view	-	10	-	Link-layer neighbours (raw)	ip neigh
clients	Network	view	-	10	-	Clients seen (neighbour table)	ip neigh
traffic	Network	auto	-	15	-	Interface counters and rate	openar-traffic
registration	Network	auto	-	15	-	Voice / data registration	dumpsys telephony.registry 2>/dev/null | grep -m1 -oE 'mVoiceRegState=[^,]+, mDataRegState=[^,]+' || echo n/a
data-state	Network	auto	-	10	-	Mobile data (1/0)	settings get global mobile_data
data	Network	act	yes	20	^(enable|disable)$	Mobile data on/off (root)	openar-data
ping	Network	view	-	15	^[A-Za-z0-9.-]{1,253}$	Ping a host or IPv4 (3 packets)	ping -c 3 -W 2
tether	Network	auto	-	15	-	Tethered interface count	count=$(dumpsys tethering 2>/dev/null | grep -c 'state=TETHERED'); echo tethered=$count
usb-state	Network	auto	-	10	-	USB functions / state	getprop sys.usb.state
airplane-state	Network	auto	-	10	-	Airplane mode (0/1)	settings get global airplane_mode_on
airplane	Network	act	yes	20	^(enable|disable)$	Airplane mode on/off	openar-airplane
wifi-state	Wireless	auto	-	10	-	Wi-Fi state	dumpsys wifi 2>/dev/null | grep -m1 'Wi-Fi is' || echo n/a
wifi	Wireless	act	yes	20	^(enable|disable)$	Wi-Fi radio on/off	svc wifi
uptime	System	auto	-	10	-	Uptime and load	uptime
disk	System	auto	-	10	-	Space used on /data	df -h /data
top	System	view	-	15	-	Top CPU processes	top -b -n 1 | head -12
reboot	System	act	yes	15	-	Reboot the device	svc power reboot
packages	System	auto	-	10	-	Installed / disabled packages	printf 'installed='; pm list packages 2>/dev/null | wc -l; printf 'disabled='; pm list packages -d 2>/dev/null | wc -l
sim	System	auto	-	10	-	SIM and operator	printf 'sim_state='; getprop gsm.sim.state; printf 'operator='; getprop gsm.operator.alpha; printf 'sim_operator='; getprop gsm.sim.operator.alpha
pkg-state	System	view	-	15	^[A-Za-z0-9_.]{3,120}$	Package state (installed/disabled)	openar-pkg state
pkg-disable	System	act	yes	20	^[A-Za-z0-9_.]{3,120}$	Disable a package (per user 0)	openar-pkg disable
pkg-enable	System	act	yes	20	^[A-Za-z0-9_.]{3,120}$	Enable a package	openar-pkg enable
pkg-stop	System	act	yes	20	^[A-Za-z0-9_.]{3,120}$	Force-stop a package	openar-pkg stop
